<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Blog - {{ site.name }}{% endblock %}</title>
  {% block head_extra %}{% endblock %}

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ gaMeasurementId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ gaMeasurementId }}');
  </script>
  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "{{ clarityId }}");
  </script>

  <link id="main-styles" rel="stylesheet" href="{{ cssPath | default('/assets/index.css') }}">
</head>
<body class="bg-white">
  <header class="sticky top-0 z-50 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex justify-between items-center gap-6">
      <a href="/" class="group flex items-center gap-3 min-w-0">
        <img src="/{{ site.logoPrimary }}" alt="{{ site.name }}" class="h-9 w-auto shrink-0" width="120" height="36">
        <span class="flex flex-col leading-[1.05] font-logo text-ink min-w-0">
          <span class="text-[0.95rem] sm:text-lg font-semibold tracking-tight group-hover:text-clay transition-colors -mb-[7px]">{{ site.brandLine1 }}</span>
          <span class="text-[0.95rem] sm:text-lg font-semibold tracking-tight text-ink-muted group-hover:text-ink transition-colors">{{ site.brandLine2 }}</span>
        </span>
      </a>
      <nav class="flex items-center gap-1 sm:gap-2 shrink-0" aria-label="Primary">
        <a href="/" class="font-display text-sm font-semibold text-ink-muted hover:text-ink px-3 py-2 rounded-md hover:bg-ink/[0.04] transition-colors">Home</a>
        <a href="/blog" class="font-display text-sm font-semibold text-ink px-3 py-2 rounded-md bg-ink/[0.06]">Blog</a>
      </nav>
    </div>
  </header>

  <main class="{% block main_class %}max-w-3xl{% endblock %} mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8 min-h-[80vh] text-gray-900">
    {% block content %}{% endblock %}
  </main>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col items-center gap-4">
              <div class="flex items-center gap-2">
                  <img src="/{{ site.logoPrimary }}" alt="{{ site.name }}" class="h-7 brightness-0 invert">
                  <div class="flex flex-col leading-none -space-y-0.5 font-logo">
                      <span class="text-base font-bold text-white tracking-tight">{{ site.brandLine1 }}</span>
                      <span class="text-base font-bold text-white tracking-tight">{{ site.brandLine2 }}</span>
                  </div>
              </div>
              <p class="text-sm text-center">
                  &copy; {{ currentYear }} {{ site.name }}. {{ site.tagline }}
              </p>
          </div>
      </div>
  </footer>
</body>
</html>
