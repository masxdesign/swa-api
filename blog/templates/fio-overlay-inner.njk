{# Expects `m` (post.metadata) and `fioCity` in scope #}
<div class="fio-icons" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-7"/><path d="M17.5 12c0-4.7-2.4-8-5.5-8S6.5 7.3 6.5 12"/><path d="M5 20.5h14"/><path d="M5 16.5c.9.4 2.4.7 4.5.7 3 0 5-1 5-1s2 1 4.5 1"/><path d="M5 12.5c.9.3 2.4.5 4.5.5 3 0 5-1 5-1s2 1 4.5 1"/></svg>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v6a6 6 0 0 0 12 0V4"/><line x1="4" x2="20" y1="20" y2="20"/></svg>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2a2 2 0 0 1-2-2 2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1-2 2 2 2 0 0 1-2-2V7"/></svg>
</div>
{% if m.street %}
<p class="fio-street">{{ m.street }}</p>
{% endif %}
{% if fioCity %}
<p class="fio-city">{{ fioCity }}</p>
{% endif %}
{% if m.postcode %}
<div class="fio-pill-row">
  <div class="fio-line"></div>
  <span class="fio-pill">{{ m.postcode }}</span>
  <div class="fio-line"></div>
</div>
{% endif %}
