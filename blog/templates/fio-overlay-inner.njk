{# Expects `m`, `fioCity`, `post` (for fio_anchor_icon_urls). Optional `fioIconLazy` for list cards. #}
<div class="fio-icons" aria-hidden="true">
  {% for url in post.fio_anchor_icon_urls %}
  <img src="{{ url }}" alt="" width="24" height="24" decoding="async" class="fio-icon-img"{% if fioIconLazy %} loading="lazy"{% endif %} />
  {% endfor %}
</div>
{% if m.street %}
<p class="fio-street">{{ m.street }}</p>
{% endif %}
{% if fioCity %}
<p class="fio-city">{{ fioCity }}</p>
{% endif %}
{% if m.postcode %}
<div class="fio-pill-row">
  <div class="fio-line"></div>
  <span class="fio-pill">{{ m.postcode }}</span>
  <div class="fio-line"></div>
</div>
{% endif %}
