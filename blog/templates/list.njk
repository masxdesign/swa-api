{% extends "layout.njk" %}

{% block title %}Blog - {{ site.name }}{% endblock %}

{% block content %}
<h1 class="text-3xl font-bold text-gray-900 mb-8">Blog</h1>
<div class="posts-list space-y-6">
  {% for post in posts %}
  <article class="post-preview">
    <h2 class="text-xl font-semibold"><a href="/blog/{{ post.title | slugify }}-{{ post.id }}" class="text-primary hover:underline">{{ post.title }}</a></h2>
    <p class="text-sm text-gray-500">{{ post.published_at }}</p>
  </article>
  {% else %}
  <p class="text-gray-600">No posts found.</p>
  {% endfor %}
</div>

{% if pagination and pagination.total_pages > 1 %}
<div class="mt-8 flex items-center gap-4">
  {% if pagination.has_prev_page %}
  <a href="/blog?page={{ pagination.page - 1 }}" class="inline-block px-4 py-2 bg-primary text-white rounded hover:bg-primary/80 transition-colors">
    Previous
  </a>
  {% endif %}

  <span class="text-gray-600">Page {{ pagination.page }} of {{ pagination.total_pages }}</span>

  {% if pagination.has_next_page %}
  <a href="/blog?page={{ pagination.page + 1 }}" class="inline-block px-4 py-2 bg-primary text-white rounded hover:bg-primary/80 transition-colors">
    Next
  </a>
  {% endif %}
</div>
{% endif %}
{% endblock %}
