{% extends "layout.njk" %}

{% block title %}{{ site.blogBadge }} - {{ site.name }}{% endblock %}

{% block head_extra %}
  <meta name="description" content="{{ site.blogDescription }}">
  <link rel="canonical" href="{{ site.url }}/blog{% if pagination and pagination.page > 1 %}?page={{ pagination.page }}{% endif %}">
  {% if pagination and pagination.has_prev_page %}
  <link rel="prev" href="{{ site.url }}/blog?page={{ pagination.page - 1 }}{% if search %}&search={{ search | urlencode }}{% endif %}">
  {% endif %}
  {% if pagination and pagination.has_next_page %}
  <link rel="next" href="{{ site.url }}/blog?page={{ pagination.page + 1 }}{% if search %}&search={{ search | urlencode }}{% endif %}">
  {% endif %}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/blog">
  <meta property="og:title" content="{{ site.blogBadge }} - {{ site.name }}">
  <meta property="og:description" content="{{ site.blogDescription }}">
  <meta property="og:image" content="{{ site.url }}/{{ site.socialImage }}">
  <meta property="og:site_name" content="{{ site.name }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{ site.url }}/blog">
  <meta name="twitter:title" content="{{ site.blogBadge }} - {{ site.name }}">
  <meta name="twitter:description" content="{{ site.blogDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/{{ site.socialImage }}">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site.url | dump | safe }} },
      { "@type": "ListItem", "position": 2, "name": "Blog" }
    ]
  }
  </script>
  {% include "fio-styles.njk" %}
{% endblock %}

{% block main_class %}max-w-6xl{% endblock %}

{% block content %}
{# ── Hero / Page Header ── #}
<section class="text-center pb-12 border-b border-slate-200">
  <span class="inline-block text-xs font-semibold tracking-widest uppercase text-primary mb-3">{{ site.blogBadge }}</span>
  <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mb-4">Blog</h1>
  <p class="max-w-2xl mx-auto text-lg text-slate-500 leading-relaxed">{{ site.blogDescription }}</p>
</section>

{# ── Search ── #}
<form action="/blog" method="get" class="max-w-xl mx-auto pt-8">
  <div class="relative">
    <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>
    <input type="text" name="search" value="{{ search }}" placeholder="Search articles..." autocomplete="off"
      class="w-full pl-11 pr-10 py-3 text-sm text-slate-800 bg-white border border-slate-200 rounded-xl shadow-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-colors" />
    {% if search %}
    <a href="/blog" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors" aria-label="Clear search">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
    </a>
    {% endif %}
  </div>
</form>

{# ── Post Grid ── #}
<section class="pt-8">
  {% if search and not posts.length %}
  <p class="text-center text-slate-500 py-16">No articles found for "<strong>{{ search }}</strong>". <a href="/blog" class="text-primary hover:underline">View all posts</a></p>
  {% elif posts.length %}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for post in posts %}
    <a href="/blog/{{ post.title | slugify }}-{{ post.id }}"
       class="group flex flex-col overflow-hidden bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md hover:border-slate-300 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
      {# Featured image — overlay when featured_image + same FIO treatment as post page #}
      <div class="blog-card-fio h-48 relative bg-gradient-to-br from-primary/10 via-accent/10 to-secondary/10 overflow-hidden border-b border-slate-100">
        {% if post.featured_image %}
        {% set m = post.metadata %}
        {% set fioCity = m.suburb or m.neighbourhood or m.borough %}
        <div class="fio-wrapper fio-thumbnail">
          <img src="{{ post.featured_image }}" alt="{{ post.title }}" width="640" height="360" decoding="async" loading="lazy" class="group-hover:scale-105 transition-transform duration-300" />
          <div class="fio-overlay">
            {% include "fio-overlay-inner.njk" %}
          </div>
        </div>
        {% else %}
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-12 h-12 text-primary/30 group-hover:scale-110 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
          </svg>
        </div>
        {% endif %}
      </div>

      <div class="flex flex-col flex-1 p-5">
        {# Category pill #}
        <span class="self-start text-[11px] font-semibold uppercase tracking-wide text-primary bg-primary/10 rounded-full px-2.5 py-0.5 mb-3">{{ post.category }}</span>

        {# Title #}
        <h2 class="text-lg font-bold text-gray-900 leading-snug group-hover:text-primary transition-colors mb-2">{{ post.title }}</h2>

        {# Date #}
        <time datetime="{{ post.published_at }}" class="text-xs text-slate-400 mb-3">{{ post.published_at }}</time>

        {# Excerpt #}
        <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 mb-4">{{ post.excerpt }}</p>

        {# CTA #}
        <span class="mt-auto text-sm font-medium text-slate-400 group-hover:text-primary transition-colors">Read article &rarr;</span>
      </div>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <p class="text-center text-slate-500 py-16">No posts found.</p>
  {% endif %}
</section>

{# ── Pagination ── #}
{% if pagination and pagination.total_pages > 1 %}
<nav class="mt-12 flex items-center justify-center gap-3" aria-label="Pagination">
  {% if pagination.has_prev_page %}
  <a href="/blog?page={{ pagination.page - 1 }}{% if search %}&search={{ search | urlencode }}{% endif %}"
     class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-colors">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
    Previous
  </a>
  {% endif %}

  <span class="text-sm text-slate-500 px-2">Page {{ pagination.page }} of {{ pagination.total_pages }}</span>

  {% if pagination.has_next_page %}
  <a href="/blog?page={{ pagination.page + 1 }}{% if search %}&search={{ search | urlencode }}{% endif %}"
     class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-colors">
    Next
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
  </a>
  {% endif %}
</nav>
{% endif %}
{% endblock %}
