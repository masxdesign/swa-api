{% extends "layout.njk" %}

{% block title %}{{ post.title }} - {{ site.name }}{% endblock %}

{% block head_extra %}
  <meta name="description" content="{{ post.excerpt }}">
  <link rel="canonical" href="{{ site.url }}/blog/{{ post.title | slugify }}-{{ post.id }}">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ site.url }}/blog/{{ post.title | slugify }}-{{ post.id }}">
  <meta property="og:title" content="{{ post.title }}">
  <meta property="og:description" content="{{ post.excerpt }}">
  <meta property="og:image" content="{{ site.url }}/{{ site.socialImage }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="article:published_time" content="{{ post.published_at }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{ site.url }}/blog/{{ post.title | slugify }}-{{ post.id }}">
  <meta name="twitter:title" content="{{ post.title }}">
  <meta name="twitter:description" content="{{ post.excerpt }}">
  <meta name="twitter:image" content="{{ site.url }}/{{ site.socialImage }}">

  <!-- Structured Data: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site.url | dump | safe }} },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": {{ (site.url + "/blog") | dump | safe }} },
      { "@type": "ListItem", "position": 3, "name": {{ post.title | dump | safe }} }
    ]
  }
  </script>

  <!-- Structured Data: BlogPosting -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ post.title | dump | safe }},
    "description": {{ post.excerpt | dump | safe }},
    "datePublished": {{ post.published_at | dump | safe }},
    "author": {
      "@type": "Organization",
      "name": {{ site.name | dump | safe }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ site.name | dump | safe }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ (site.url + "/" + site.logoPrimary) | dump | safe }}
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ (site.url + "/blog/" + (post.title | slugify) + "-" + post.id) | dump | safe }}
    },
    "image": {{ (site.url + "/" + site.socialImage) | dump | safe }}
  }
  </script>

  {% include "fio-styles.njk" %}
{% endblock %}

{% block main_class %}max-w-6xl{% endblock %}

{% block content %}
{# ── Post Header ── #}
<header class="mb-10">
  <p class="mb-4"><a href="/blog" class="text-sm text-primary hover:underline">&larr; Back to blog</a></p>
  <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-3 leading-tight">{{ post.title }}</h1>
  <div class="flex items-center gap-4 flex-wrap">
    <time datetime="{{ post.published_at }}" class="text-sm text-slate-400">Published {{ post.published_at }}</time>
    <div class="flex items-center gap-1.5">
      <span class="text-xs text-slate-400 mr-0.5">Share</span>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ (site.url + '/blog/' + (post.title | slugify) + '-' + post.id) | urlencode }}" target="_blank" rel="noopener" aria-label="Share on Facebook" class="share-btn inline-flex items-center justify-center w-8 h-8 rounded-full text-slate-400 hover:text-white hover:bg-[#1877F2] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
      </a>
      <a href="https://x.com/intent/tweet?url={{ (site.url + '/blog/' + (post.title | slugify) + '-' + post.id) | urlencode }}&text={{ post.title | urlencode }}" target="_blank" rel="noopener" aria-label="Share on X" class="share-btn inline-flex items-center justify-center w-8 h-8 rounded-full text-slate-400 hover:text-white hover:bg-black transition-colors">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <button type="button" aria-label="Copy link" onclick="copyShareLink(this)" class="share-btn inline-flex items-center justify-center w-8 h-8 rounded-full text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
        <svg class="w-4 h-4 share-icon-link" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        <svg class="w-4 h-4 share-icon-check hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </button>
    </div>
  </div>
</header>

{# ── Two-column grid ── #}
<div class="lg:grid lg:grid-cols-12 lg:gap-10">

  {# ── Article content (left) ── #}
  <article id="article-content" class="lg:col-span-8 min-w-0">
    {# Featured image hero #}
    <div class="post-hero-fio mb-10 -mx-4 sm:mx-0">
      {% if post.featured_image %}
      {% set m = post.metadata %}
      {% set fioCity = m.suburb or m.neighbourhood or m.borough %}
      <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-100">
        <div class="fio-wrapper fio-full">
          <img src="{{ post.featured_image }}" alt="{{ post.title }}" width="1920" height="1080" decoding="async" class="fio-backdrop" />
          <div class="fio-overlay">
            {% include "fio-overlay-inner.njk" %}
          </div>
        </div>
      </div>
      {% else %}
      <div class="rounded-2xl overflow-hidden border border-slate-100 shadow-sm">
        <div class="w-full h-64 sm:h-80 lg:h-96 bg-gradient-to-br from-primary/10 via-accent/10 to-secondary/10 flex items-center justify-center">
          <svg class="w-16 h-16 text-primary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
          </svg>
        </div>
      </div>
      {% endif %}
    </div>

    <div class="prose prose-lg max-w-none text-gray-900">
      {{ contentHtml | safe }}
    </div>
  </article>

  {# ── TOC sidebar (right) — only if 2+ headings ── #}
  {% if headingCount >= 2 %}
  <aside class="lg:col-span-4 mt-10 lg:mt-0">

    {# Mobile: collapsible accordion #}
    <details class="lg:hidden rounded-2xl border border-slate-200 bg-white shadow-sm mb-8">
      <summary class="cursor-pointer select-none p-4 text-sm font-semibold text-slate-700">Contents</summary>
      <nav class="px-4 pb-4">
        <ul class="space-y-1.5">
          {% for item in toc %}
          <li>
            <a href="#{{ item.id }}" class="block text-sm font-medium text-slate-700 hover:text-slate-900 hover:underline">{{ item.text }}</a>
            {% if item.children.length %}
            <ul class="mt-1 space-y-1">
              {% for child in item.children %}
              <li><a href="#{{ child.id }}" class="block text-xs text-slate-500 ml-3 hover:text-slate-900 hover:underline">{{ child.text }}</a></li>
              {% endfor %}
            </ul>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% if post.extractedPostcodes.length %}
        <div class="mt-4 pt-3 border-t border-slate-100">
          <p class="text-xs text-slate-500 mb-2">Explore available properties in the areas mentioned in this article.</p>
          <div class="flex flex-col gap-2">
            {% for pc in post.extractedPostcodes %}
            <a href="https://property.pub/{{ advertiserId }}/search?postcode={{ pc | urlencode }}" target="_blank" rel="noopener" class="flex items-center justify-between gap-2 text-sm font-semibold text-white bg-primary rounded-lg px-3 py-2 hover:bg-primary/85 transition-colors">
              <span>Properties in {{ pc }}</span>
              <span>&rarr;</span>
            </a>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </nav>
    </details>

    {# Desktop: sticky sidebar #}
    <div class="hidden lg:block sticky top-24 space-y-4">
      <nav class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5">
        <p class="text-sm font-semibold text-slate-700 mb-3">Contents</p>
        <ul id="toc-list" class="space-y-1">
          {% for item in toc %}
          <li>
            <a href="#{{ item.id }}" data-toc-id="{{ item.id }}"
               class="toc-link block text-sm font-medium text-slate-600 py-1 border-l-2 border-transparent pl-3 hover:text-slate-900 hover:underline transition-colors">{{ item.text }}</a>
            {% if item.children.length %}
            <ul class="space-y-0.5">
              {% for child in item.children %}
              <li>
                <a href="#{{ child.id }}" data-toc-id="{{ child.id }}"
                   class="toc-link block text-xs text-slate-400 py-0.5 border-l-2 border-transparent pl-6 hover:text-slate-900 hover:underline transition-colors">{{ child.text }}</a>
              </li>
              {% endfor %}
            </ul>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </nav>

      {% if post.extractedPostcodes.length %}
      <div class="rounded-2xl border border-primary/20 bg-primary/5 shadow-sm p-5">
        <p class="text-sm font-semibold text-slate-700 mb-1">Search properties</p>
        <p class="text-xs text-slate-500 mb-3">Explore available properties in the areas mentioned in this article.</p>
        <div class="flex flex-col gap-2">
          {% for pc in post.extractedPostcodes %}
          <a href="https://property.pub/{{ advertiserId }}/search?postcode={{ pc | urlencode }}" target="_blank" rel="noopener" class="flex items-center justify-between gap-2 text-sm font-semibold text-white bg-primary rounded-lg px-4 py-2.5 hover:bg-primary/85 transition-colors">
            <span>Properties in {{ pc }}</span>
            <span>&rarr;</span>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </aside>
  {% endif %}
</div>

{# ── Prev / Next navigation ── #}
{% if post.prev_post or post.next_post %}
<nav class="mt-10 border-t border-slate-200 pt-8 grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="Post navigation">
  {% if post.prev_post %}
  <a href="/blog/{{ post.prev_post.title | slugify }}-{{ post.prev_post.id }}"
     class="group flex flex-col p-4 rounded-xl border border-slate-200 hover:border-slate-300 hover:shadow-sm transition-all">
    <span class="text-xs font-medium text-slate-400 mb-1">&larr; Previous</span>
    <span class="text-sm font-semibold text-slate-700 group-hover:text-primary transition-colors line-clamp-2">{{ post.prev_post.title }}</span>
  </a>
  {% else %}
  <div></div>
  {% endif %}

  {% if post.next_post %}
  <a href="/blog/{{ post.next_post.title | slugify }}-{{ post.next_post.id }}"
     class="group flex flex-col p-4 rounded-xl border border-slate-200 hover:border-slate-300 hover:shadow-sm transition-all sm:text-right">
    <span class="text-xs font-medium text-slate-400 mb-1">Next &rarr;</span>
    <span class="text-sm font-semibold text-slate-700 group-hover:text-primary transition-colors line-clamp-2">{{ post.next_post.title }}</span>
  </a>
  {% endif %}
</nav>
{% endif %}

<div class="mt-8">
  <a href="/blog" class="text-sm text-primary hover:underline">&larr; Back to blog</a>
</div>

{# ── Share helpers ── #}
<script>
var shareBaseUrl = '{{ site.url }}/blog/{{ post.title | slugify }}-{{ post.id }}';

function copyShareLink(btn) {
  var heading = btn.closest('h2[id], h3[id]');
  var url = heading ? shareBaseUrl + '#' + heading.id : shareBaseUrl;
  navigator.clipboard.writeText(url).then(function() {
    var iconLink = btn.querySelector('.share-icon-link');
    var iconCheck = btn.querySelector('.share-icon-check');
    iconLink.classList.add('hidden');
    iconCheck.classList.remove('hidden');
    setTimeout(function() {
      iconLink.classList.remove('hidden');
      iconCheck.classList.add('hidden');
    }, 2000);
  });
}

(function() {
  // Heading hover share buttons
  var article = document.getElementById('article-content');
  if (!article) return;

  var headings = article.querySelectorAll('h2[id], h3[id]');
  headings.forEach(function(heading) {
    heading.classList.add('group', 'relative');

    var wrapper = document.createElement('span');
    wrapper.className = 'heading-share opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200 inline-flex items-center gap-1 ml-4 align-middle whitespace-nowrap';

    wrapper.innerHTML =
      '<a href="https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(shareBaseUrl + '#' + heading.id) + '" target="_blank" rel="noopener" aria-label="Share section on Facebook" class="share-btn inline-flex items-center justify-center w-7 h-7 rounded-full text-slate-300 hover:text-white hover:bg-[#1877F2] transition-colors">' +
        '<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>' +
      '</a>' +
      '<a href="https://x.com/intent/tweet?url=' + encodeURIComponent(shareBaseUrl + '#' + heading.id) + '&text=' + encodeURIComponent(heading.textContent.trim()) + '" target="_blank" rel="noopener" aria-label="Share section on X" class="share-btn inline-flex items-center justify-center w-7 h-7 rounded-full text-slate-300 hover:text-white hover:bg-black transition-colors">' +
        '<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>' +
      '</a>' +
      '<button type="button" aria-label="Copy section link" onclick="copyShareLink(this)" class="share-btn inline-flex items-center justify-center w-7 h-7 rounded-full text-slate-300 hover:text-white hover:bg-slate-700 transition-colors">' +
        '<svg class="w-3.5 h-3.5 share-icon-link" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>' +
        '<svg class="w-3.5 h-3.5 share-icon-check hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' +
      '</button>';

    heading.appendChild(wrapper);
  });
})();
</script>

{% if headingCount >= 2 %}
<script>
(function() {
  // Smooth scroll for TOC links
  document.querySelectorAll('a[href^="#"]').forEach(function(link) {
    link.addEventListener('click', function(e) {
      var target = document.getElementById(this.getAttribute('href').slice(1));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', this.getAttribute('href'));
      }
    });
  });

  // IntersectionObserver for active heading highlight
  var tocLinks = document.querySelectorAll('#toc-list .toc-link');
  if (!tocLinks.length) return;

  var headingIds = [];
  tocLinks.forEach(function(l) { headingIds.push(l.getAttribute('data-toc-id')); });

  var activeId = null;

  function setActive(id) {
    if (id === activeId) return;
    activeId = id;
    tocLinks.forEach(function(link) {
      var linkId = link.getAttribute('data-toc-id');
      var isH3 = link.classList.contains('text-xs');
      if (linkId === id) {
        link.classList.remove('border-transparent', 'text-slate-600', 'text-slate-400', 'font-medium');
        link.classList.add('border-primary', 'text-slate-900');
        if (!isH3) link.classList.add('font-semibold');
      } else {
        link.classList.remove('border-primary', 'text-slate-900', 'font-semibold');
        link.classList.add('border-transparent');
        link.classList.add(isH3 ? 'text-slate-400' : 'text-slate-600');
        if (!isH3) link.classList.add('font-medium');
      }
    });
  }

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        setActive(entry.target.id);
      }
    });
  }, { rootMargin: '0px 0px -70% 0px', threshold: 0 });

  headingIds.forEach(function(id) {
    var el = document.getElementById(id);
    if (el) observer.observe(el);
  });
})();
</script>
{% endif %}
{% endblock %}
