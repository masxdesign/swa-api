{% extends "layout.njk" %}

{% block title %}Post Not Found - {{ site.name }}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex,follow">
{% endblock %}

{% block content %}
<h1 class="text-3xl font-bold text-gray-900 mb-4">Post Not Found</h1>
<p class="text-gray-600 mb-4">The requested blog post does not exist.</p>
<p class="text-gray-600">
  <a href="/blog" class="text-primary hover:underline">← Back to blog</a>
</p>
{% endblock %}
